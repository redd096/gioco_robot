[sub_resource type="Shader" id="BackgroundShader"]
code = "shader_type canvas_item;

void fragment() {
	vec2 uv = UV;
	float center_glow = 1.0 - smoothstep(0.05, 0.78, distance(uv, vec2(0.62, 0.38)));
	float horizon = 1.0 - smoothstep(0.0, 0.55, abs(uv.y - 0.48));
	vec2 grid_uv = abs(fract(uv * vec2(42.0, 24.0)) - 0.5);
	float grid = (1.0 - smoothstep(0.475, 0.5, max(grid_uv.x, grid_uv.y))) * 0.018;
	vec3 base = vec3(0.004, 0.014, 0.018);
	vec3 teal = vec3(0.012, 0.065, 0.072) * center_glow * 0.72;
	vec3 scan = vec3(0.005, 0.018, 0.02) * horizon;
	COLOR = vec4(base + teal + scan + vec3(0.02, 0.08, 0.08) * grid, 1.0);
}"

